{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AI Video 文档",
  "description": "AI Video API 接入指南与供应商配置说明",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "appearance": {
    "default": "system"
  },
  "search": {
    "prompt": "搜索文档"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "API 参考",
        "groups": [
          {
            "group": "开始调试",
            "pages": [
              "api-reference/overview"
            ]
          },
          {
            "group": "账户与模型",
            "pages": [
              "account",
              "models",
              "conversation/models-and-errors",
              "api-reference/get-gemini-models"
            ]
          },
          {
            "group": "素材文件",
            "pages": [
              "files/upload",
              "api-reference/delete-file"
            ]
          },
          {
            "group": "图片生成",
            "pages": [
              "images/create",
              "images/query"
            ]
          },
          {
            "group": "OpenAI 图片兼容",
            "pages": [
              "api-reference/image-generations",
              "api-reference/image-generations-async",
              "api-reference/image-edits",
              "api-reference/image-edits-async",
              "api-reference/get-image-batch"
            ]
          },
          {
            "group": "视频生成",
            "pages": [
              "videos/create",
              "videos/query"
            ]
          },
          {
            "group": "对话协议",
            "pages": [
              "conversation/chat-completions",
              "conversation/responses",
              "conversation/anthropic",
              "conversation/gemini",
              "api-reference/gemini-stream"
            ]
          },
          {
            "group": "Responses 资源",
            "pages": [
              "api-reference/get-response",
              "api-reference/delete-response",
              "api-reference/cancel-response",
              "api-reference/response-input-items"
            ]
          },
          {
            "group": "Token 与上下文",
            "pages": [
              "api-reference/compact-response",
              "api-reference/response-input-tokens",
              "api-reference/anthropic-count-tokens",
              "api-reference/gemini-count-tokens"
            ]
          }
        ]
      },
      {
        "tab": "接入指南",
        "groups": [
          {
            "group": "开始接入",
            "pages": [
              "introduction",
              "quickstart",
              "api-overview",
              "authentication"
            ]
          },
          {
            "group": "对话模型",
            "pages": [
              "conversation/protocols",
              "conversation/sdk-examples",
              "conversation/websocket",
              "conversation/reverse-proxy"
            ]
          },
          {
            "group": "图片生成",
            "pages": [
              "images/openai-compatible"
            ]
          },
          {
            "group": "接口约定",
            "pages": [
              "tasks/status",
              "tasks/python-example",
              "parameters",
              "errors"
            ]
          }
        ]
      },
      {
        "tab": "管理指南",
        "groups": [
          {
            "group": "供应商配置",
            "pages": [
              "administration/provider-routes"
            ]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "redirects": [
    {
      "source": "/openapi-integration-guide",
      "destination": "/quickstart"
    },
    {
      "source": "/api-provider-route-admin-guide",
      "destination": "/administration/provider-routes"
    }
  ],
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "url": "full",
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript"
      ],
      "defaults": "required",
      "prefill": true
    }
  }
}
